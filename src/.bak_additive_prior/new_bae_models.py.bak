@dataclass
class ConvBMF(LinearGaussianBMF):
    """Convolutional operator: the same linear-Gaussian template in a
    translation-invariant space, so it plugs in a ConvOperator (which carries
    the convbmf search) and otherwise inherits everything."""

    kernel_size: int = None

    def init_params(self, X, **opt_args):
        self.operator = ConvOperator()
        # init GP kernels K, b + operator.optimizer (bae_models.ConvBMF:1231)
        ...

    # MStep inherited; ConvOperator.backward carries the seq-NMF orthogonality reg.


@dataclass
class SpikeNMF(LinearGaussianBMF):
    """FULL PORT of bae_models.SpikeNMF.

    A TorchMatrixOp (nn.Linear decoder) + a LatentPrior with slab=True.  The
    binary spike, the regularizers and the decoder are identical to every other
    matrix model; the slab flag just makes the effective latent a continuous
    multiplier Z and swaps the link sbmf -> snmf, and the M-step is the usual
    autograd step on W -- only fed the continuous ES = S*Z instead of a binary S.
    EStep / __call__ / loglikelihood are inherited.  Constructor is a drop-in for
    the original.  (See test_spikenmf_port.py.)
    """

    nonneg: bool = True
    sparse_reg: float = 0
    tree_reg: float = 1e-2
    slab_prior: float = 1
    weight_pr_reg: float = 1e-1
    weight_l1_reg: float = 0
    weight_l2_reg: float = 1e-2
    m_iters: int = 1

    def __post_init__(self):
        super().__post_init__()
        self.operator = TorchMatrixOp(fit_intercept=self.fit_intercept,
                                      nonneg=self.nonneg,
                                      resample_dead=True,
                                      pr_reg=self.weight_pr_reg,
                                      l1_reg=self.weight_l1_reg,
                                      l2_reg=self.weight_l2_reg)
        # "has a slab" == "the latent prior has slab=True"
        self.latent_prior = LatentPrior(slab=True,
                                        sparse_reg=self.sparse_reg,
                                        tree_reg=self.tree_reg,
                                        slab_prior=self.slab_prior)

    # init_params + MStep inherited: TorchMatrixOp.init_params builds the
    # nn.Linear + optimizer (resampling dead columns at init too), and
    # TorchMatrixOp.backward does the autograd update.  The whole model body is
    # now just the component assembly in __post_init__.  Bit-for-bit vs the
    # original (test_spikenmf_port).


@dataclass
class SpikeRRNMF(RRBMF):
    """Reduced-rank + slab, reusing RRBMF's ReducedRankOp and its entire M-step
    unchanged -- the only change from RRBMF is flipping the latent prior's slab
    flag on.  The existence of both this and SpikeNMF (same slab flag, different
    operator) is the proof that the slab is a latent-side concern, orthogonal to
    the operator.  (bae_models.SpikeRRNMF.)"""

    slab_prior: float = 1.0

    def __post_init__(self):
        super().__post_init__()
        self.latent_prior.slab = True            # RRBMF's prior, now spike-and-slab
        self.latent_prior.slab_prior = self.slab_prior
